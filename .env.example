NODE_ENV=development
PORT=3000
# Comma-separated list. "*" is rejected when NODE_ENV=production.
CORS_ORIGIN=*
# Number of reverse proxies in front of the app (0 = none).
TRUST_PROXY=0
# Max requests per IP per minute.
RATE_LIMIT_MAX=100
# MySQL, e.g. the one from `docker compose up -d mysql`.
DATABASE_URL=mysql://app:app@127.0.0.1:3306/app
# Optional. Shared cache, rate limits and background jobs (run `npm run worker`).
# Leave empty to keep everything in-process.
REDIS_URL=redis://127.0.0.1:6379
# Required, at least 32 chars. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime in seconds.
JWT_TTL_SECONDS=900
# Refresh token lifetime in seconds (default 30 days).
REFRESH_TOKEN_TTL_SECONDS=2592000
# Optional SMTP server. Without SMTP_HOST, emails are written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Boilerplate <no-reply@example.com>
# Uploaded files directory and size limit (bytes).
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880
