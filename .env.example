NODE_ENV=development
PORT=3000
# Comma-separated list. "*" is rejected when NODE_ENV=production.
CORS_ORIGIN=*
# Number of reverse proxies in front of the app (0 = none).
TRUST_PROXY=0
# Max requests per IP per minute.
RATE_LIMIT_MAX=100
DATABASE_URL=dev.db
# Required, at least 32 chars. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Access token lifetime in seconds.
JWT_TTL_SECONDS=900
